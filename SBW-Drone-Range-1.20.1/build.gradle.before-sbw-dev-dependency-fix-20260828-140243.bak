plugins {
    id 'java-library'
    id 'maven-publish'
    id 'idea'
    id 'net.neoforged.moddev' version '2.0.80'
}

version = mod_version
group = mod_group_id
def jeiVersion = '19.39.0.372'

def sbwSourceProjectDirs = [
        file('C:/Users/Gebruiker/Desktop/DRONE WAREFARE MOD/SuperbWarfare-0.8.9-1.21'),
        file('C:/Users/Gebruiker/Desktop/DRONE WAREFARE MOD/SuperbWarfare-0.8.8-1.21'),
        file('C:/Users/Gebruiker/Desktop/SuperbWarfare-0.8.9-1.21'),
        file('C:/Users/Gebruiker/Desktop/SuperbWarfare-0.8.8-1.21'),
        file('C:/Users/Gebruiker/Desktop/DRONE WAREFARE MOD/SuperbWarfare-0.8.9-1.20'),
        file('C:/Users/Gebruiker/Desktop/DRONE WAREFARE MOD/SuperbWarfare-0.8.8')
].findAll { it.exists() }

def sbwRuntimeSourceProjectDir = sbwSourceProjectDirs.find { dir ->
    new File(dir, 'build/resources/main/META-INF/neoforge.mods.toml').exists()
            && new File(dir, 'build/resources/main/mixins.superbwarfare.json').exists()
            && (new File(dir, 'build/classes/java/main').exists()
            || new File(dir, 'build/classes/kotlin/main').exists())
}

def sbwCompileOnlyInputs = sbwSourceProjectDirs.collectMany { dir ->
    [
            new File(dir, 'build/classes/java/main'),
            new File(dir, 'build/classes/kotlin/main'),
            new File(dir, 'build/resources/main'),
            new File(dir, 'src/build/classes/java/main'),
            new File(dir, 'src/build/classes/kotlin/main'),
            new File(dir, 'src/build/resources/main')
    ].findAll { it.exists() }
}

def sbwCompileOnlyJars = sbwSourceProjectDirs.collectMany { dir ->
    [
            new File(dir, 'build/libs'),
            new File(dir, 'src/build/libs')
    ].findAll { it.exists() }.collectMany { libs ->
        fileTree(libs) {
            include '*.jar'
            exclude '*-sources.jar'
            exclude '*-javadoc.jar'
        }.files
    }
}

// Use the installed 1.21.1 Superb Warfare jar when no local SBW source project is available.
// This keeps the addon buildable while preserving its optional runtime SBW integration.
def sbwFallbackJar = [
        file('C:/Users/Gebruiker/curseforge/minecraft/Instances/1.21.1/mods/superbwarfare-0.8.9-final-mc1.21.1-9b5284f4.jar'),
        file('C:/Users/Gebruiker/AppData/Roaming/ModrinthApp/profiles/NeoForge 1.21.1/mods/superbwarfare-0.8.9-final-mc1.21.1-9b5284f4.jar')
].find { it.exists() }

def curiosRuntimeJar = [
        file('C:/Users/Gebruiker/curseforge/minecraft/Instances/1.21.1/mods/curios-neoforge-9.5.1+1.21.1.jar'),
        file('C:/Users/Gebruiker/AppData/Roaming/ModrinthApp/profiles/NeoForge 1.21.1/mods/curios-neoforge-9.5.1+1.21.1.jar')
].find { it.exists() }

def kotlinForForgeRuntimeJar = [
        file('C:/Users/Gebruiker/curseforge/minecraft/Instances/1.21.1/mods/kotlinforforge-5.12.0-all.jar'),
        file('C:/Users/Gebruiker/AppData/Roaming/ModrinthApp/profiles/NeoForge 1.21.1/mods/kotlinforforge-5.12.0-all.jar')
].find { it.exists() }

tasks.named('wrapper', Wrapper).configure {
    distributionType = Wrapper.DistributionType.BIN
}

sourceSets.main.resources {
    srcDir('src/generated/resources')
    exclude('**/*.bbmodel')
    exclude('src/generated/**/.cache')
}

base {
    archivesName = 'sbw-drone-warfare'
}

java {
    toolchain.languageVersion = JavaLanguageVersion.of(21)
    withSourcesJar()
}

sourceSets {
    sbwRuntime {
        java.srcDirs = []
        resources.srcDirs = []
    }
}

tasks.register('syncSbwRuntimeClasses', Sync) {
    if (sbwRuntimeSourceProjectDir != null) {
        from(new File(sbwRuntimeSourceProjectDir, 'build/classes/java/main'))
        from(new File(sbwRuntimeSourceProjectDir, 'build/classes/kotlin/main'))
    }
    into(layout.buildDirectory.dir('classes/java/sbwRuntime'))
}

tasks.register('syncSbwRuntimeResources', Sync) {
    if (sbwRuntimeSourceProjectDir != null) {
        from(new File(sbwRuntimeSourceProjectDir, 'build/resources/main'))
    }
    into(layout.buildDirectory.dir('resources/sbwRuntime'))
}

tasks.matching { it.name in ['runClient', 'runServer'] }.configureEach {
    dependsOn tasks.named('syncSbwRuntimeClasses')
    dependsOn tasks.named('syncSbwRuntimeResources')
}

neoForge {
    version = neo_version

    parchment {
        minecraftVersion = parchment_minecraft_version
        mappingsVersion = parchment_mappings_version
    }

    runs {
        create('client') {
            client()
            systemProperty 'neoforge.enabledGameTestNamespaces', mod_id
        }

        create('server') {
            server()
            programArgument '--nogui'
            systemProperty 'neoforge.enabledGameTestNamespaces', mod_id
        }

        create('data') {
            data()
            programArguments.addAll '--mod', mod_id, '--all', '--output', file('src/generated/resources').absolutePath, '--existing', file('src/main/resources').absolutePath
        }

        configureEach {
            systemProperty 'forge.logging.markers', 'REGISTRIES'
            logLevel = org.slf4j.event.Level.DEBUG
        }
    }

    mods {
        create(mod_id) {
            sourceSet sourceSets.main
        }
        if (sbwRuntimeSourceProjectDir != null) {
            create('superbwarfare') {
                sourceSet sourceSets.sbwRuntime
            }
        }
    }
}

repositories {
    mavenLocal()
    maven {
        url = 'https://repo.spongepowered.org/repository/maven-public/'
    }
    maven {
        name = 'GeckoLib'
        url = 'https://dl.cloudsmith.io/public/geckolib3/geckolib/maven/'
        content {
            includeGroupByRegex('software\\.bernie.*')
        }
    }
    maven {
        name = 'JEI'
        url = 'https://maven.blamejared.com'
    }
    maven {
        name = 'JitPack'
        url = 'https://jitpack.io'
        content {
            includeGroup 'com.github.MCModderAnchor'
        }
    }
    mavenCentral()
}

configurations {
    localRuntime
    runtimeClasspath.extendsFrom localRuntime
}

dependencies {
    implementation 'software.bernie.geckolib:geckolib-neoforge-1.21.1:4.7.5'
    compileOnly "mezz.jei:jei-1.21.1-common-api:${jeiVersion}"
    compileOnly "mezz.jei:jei-1.21.1-neoforge-api:${jeiVersion}"
    localRuntime "mezz.jei:jei-1.21.1-neoforge:${jeiVersion}"
    compileOnly 'org.spongepowered:mixin:0.8.5'
    annotationProcessor 'org.spongepowered:mixin:0.8.5:processor'
    testImplementation 'org.junit.jupiter:junit-jupiter:5.10.2'
    testImplementation 'com.google.code.gson:gson:2.11.0'
    localRuntime('com.github.MCModderAnchor:SimpleBedrockModel:2.3.3-neoforge-mc1.21.1') {
        transitive = false
    }

    if (!sbwCompileOnlyInputs.isEmpty()) {
        compileOnly files(sbwCompileOnlyInputs)
    }
    if (!sbwCompileOnlyJars.isEmpty()) {
        compileOnly files(sbwCompileOnlyJars)
    }
    if (sbwCompileOnlyInputs.isEmpty() && sbwCompileOnlyJars.isEmpty() && sbwFallbackJar != null) {
        compileOnly files(sbwFallbackJar)
        localRuntime files(sbwFallbackJar)
    }
    if (curiosRuntimeJar != null) {
        localRuntime files(curiosRuntimeJar)
    }
    if (kotlinForForgeRuntimeJar != null) {
        localRuntime files(kotlinForForgeRuntimeJar)
    }
}

sourceSets.test.compileClasspath += sourceSets.main.compileClasspath
sourceSets.test.runtimeClasspath += sourceSets.main.runtimeClasspath

tasks.withType(ProcessResources).configureEach {
    def replaceProperties = [
            minecraft_version      : minecraft_version,
            minecraft_version_range: minecraft_version_range,
            neo_version            : neo_version,
            loader_version_range   : loader_version_range,
            sbw_version_range      : sbw_version_range,
            mod_id                 : mod_id,
            mod_name               : mod_name,
            mod_license            : mod_license,
            mod_version            : mod_version,
            mod_authors            : mod_authors,
            mod_description        : mod_description
    ]
    inputs.properties replaceProperties

    filesMatching(['META-INF/neoforge.mods.toml', 'pack.mcmeta']) {
        expand replaceProperties
    }
}

tasks.named('jar', Jar).configure {
    manifest {
        attributes(
                'MixinConfigs': 'sbwdroneconfig.mixins.json'
        )
    }
}

tasks.withType(JavaCompile).configureEach {
    options.encoding = 'UTF-8'
}

tasks.named('test', Test).configure {
    useJUnitPlatform()
}

publishing {
    publications {
        register('mavenJava', MavenPublication) {
            from components.java
        }
    }
    repositories {
        maven {
            url "file://${project.projectDir}/repo"
        }
    }
}

idea {
    module {
        downloadSources = true
        downloadJavadoc = true
    }
}
